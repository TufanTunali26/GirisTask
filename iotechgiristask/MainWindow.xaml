<Window x:Class="iotechgiristask.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IOTECH - Server Uygulaması" Height="460" Width="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Server Kontrol Paneli" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

        <!-- 1. Grup (Lamba Grubu) -->
        <GroupBox Grid.Row="1" Header="1. Grup (Lamba Grubu)" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="LampGraphic" Width="60" Height="60" Fill="#424242" Stroke="#212121" StrokeThickness="3" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtLampStatus" Text="Lamba: KAPALI" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <Button x:Name="BtnToggleLamp" Content="Lambayı Aç / Kapat" Width="180" Height="32" Click="BtnToggleLamp_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- 2. Grup (Text Grubu) -->
        <GroupBox Grid.Row="2" Header="2. Grup (Text Grubu)" Margin="0,0,0,10" Padding="10">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Text="Metin Alanı:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                <TextBox x:Name="TxtInput" Text="0" Height="32" VerticalContentAlignment="Center" FontSize="14" Padding="5,0" TextChanged="TxtInput_TextChanged" Margin="0,0,0,10"/>
                <Button x:Name="BtnRandom" Content="Rastgele Sayı Üret" Height="32" Click="BtnRandom_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- Durum Bildirimi -->
        <Border Grid.Row="3" Background="#F0F0F0" CornerRadius="4" Padding="8,5">
            <TextBlock x:Name="TxtStatus" Text="MQTT Server başlatılıyor..." Foreground="#555555" FontSize="12"/>
        </Border>
    </Grid>
</Window>
